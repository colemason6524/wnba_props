[Unit]
Description=Schedule one daily WNBA pregame forecast capture (early tip coverage)

[Timer]
# Single daily trigger. The pipeline itself waits until 75 minutes before the
# earliest untipped game, so this must not fire more than once per day.
OnCalendar=*-*-* 10:00:00 America/Detroit
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=sports-wnba-forecast@pregame.service

[Install]
WantedBy=timers.target
