[Unit]
Description=WNBA forecast board (prediction-first, slot %i)
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/wnba_props/scripts/run_linux_task.sh

[Service]
Type=oneshot
Environment=WNBA_FORECAST_SLOT=%i
ExecStart=%h/wnba_props/scripts/run_linux_task.sh forecast
TimeoutStartSec=infinity
